  "issues": {
    "missing_entity": {
      "title": "Mental Health: {entity} is missing",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Remove missing source",
            "description": "{entity} (used for {name}) no longer exists. Remove the reference? Learned data and entries are kept – you can add a new source in the profile at any time."
          }
        }
      }
    },
    "missing_target": {
      "title": "Mental Health: notification target {entity} is missing",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Remove notification target",
            "description": "Check-in notifications for {name} cannot reach {entity}. Is the Companion App still logged in? Remove the target now and add the new device in the profile."
          }
        }
      }
    }
  },
